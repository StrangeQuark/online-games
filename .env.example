# docker compose reads this file after copying to .env.
# Export these variables in your backend shell if you change the defaults.
DATABASE_URL=jdbc:postgresql://localhost:5432/arcade
DATABASE_USER=arcade
DATABASE_PASSWORD=arcade_dev_only
PORT=8080
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Set true with HTTPS in production.
SESSION_COOKIE_SECURE=false
